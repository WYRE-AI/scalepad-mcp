{
  "name": "@wyre-ai/scalepad-mcp",
  "version": "1.0.0",
  "description": "ScalePad MCP server (Core, Lifecycle Manager, ControlMap, Backup Radar, Quoter) with decision-tree navigation for Claude",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "scalepad-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-dual-era.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WYRE-AI/scalepad-mcp.git"
  },
  "keywords": [
    "mcp",
    "claude",
    "scalepad",
    "lifecycle-manager",
    "controlmap",
    "backup-radar",
    "quoter",
    "msp",
    "decision-tree"
  ],
  "author": "Wyre Technology",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/WYRE-AI/scalepad-mcp/issues"
  },
  "homepage": "https://github.com/WYRE-AI/scalepad-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@wyre-technology/node-scalepad": "^1.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@types/node": "^26.4.0",
    "semantic-release": "^25.0.9",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
